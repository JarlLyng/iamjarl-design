{
  "name": "@iamjarl/design-tokens",
  "version": "1.14.0",
  "description": "IAMJARL Design System tokens for web and React Native",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/ts/tokens.js",
  "types": "./dist/ts/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/tokens.d.ts",
      "import": "./dist/ts/tokens.js",
      "default": "./dist/ts/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./css/shadow": "./dist/css/tokens.shadow.css",
    "./components": "./dist/components/ij-footer.js",
    "./components/footer": "./dist/components/ij-footer.js",
    "./components/nav": "./dist/components/ij-nav.js",
    "./footers/*": "./dist/footers/*",
    "./identity/*": "./dist/identity/*",
    "./apps.json": "./apps.json",
    "./sri.json": "./dist/sri.json",
    "./tokens.json": "./tokens.json",
    "./design.md": "./design.md",
    "./patterns/*": "./patterns/*"
  },
  "files": [
    "dist/",
    "apps.json",
    "tokens.json",
    "design.md",
    "patterns/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "validate": "node scripts/validate.js",
    "test": "node scripts/test.js",
    "test:browser": "node scripts/test-browser.js",
    "serve": "npx --yes serve . --listen 3000",
    "dev": "npm run build && npm run serve"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jarllyng/iamjarl-design.git"
  },
  "license": "MIT"
}
