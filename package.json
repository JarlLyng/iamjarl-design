{
  "name": "@iamjarl/design-tokens",
  "version": "0.5.0",
  "description": "IAMJARL Design System tokens for web and React Native",
  "type": "module",
  "main": "./dist/ts/tokens.js",
  "types": "./dist/ts/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/tokens.d.ts",
      "import": "./dist/ts/tokens.js",
      "default": "./dist/ts/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./css/shadow": "./dist/css/tokens.shadow.css",
    "./tokens.json": "./tokens.json",
    "./design.md": "./design.md"
  },
  "files": [
    "dist/",
    "tokens.json",
    "design.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "validate": "node scripts/validate.js",
    "test": "node scripts/test.js",
    "serve": "npx --yes serve . --listen 3000",
    "dev": "npm run build && npm run serve"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jarllyng/iamjarl-design.git"
  },
  "license": "MIT"
}
